{% extends "base" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Email</th>
                <th>Is active</th>
                <th>Oauth provider</th>
                <th>Twofa enabled</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
            <tr>
                <td>{{ user.email }}</td>
                <td>{{ user.is_active }}</td>
                <td>{{ user.oauth_provider | default(value="local")}}</td>
                <td>{{ user.twofa_enabled }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}